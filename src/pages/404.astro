---
import Base from "~/layouts/Base.astro";
---

<Base title="404: Not Found" noIndex={true}>
	<section aria-label="Page not found" class="pt-16 md:pt-28 pb-12">
		<p class="text-[15px] text-ink-3 tabular">404</p>
		<h1
			class="rise mt-3 font-display text-[clamp(40px,8vw,80px)] leading-[1.04] text-ink"
		>
			This page doesn't exist.
		</h1>
		<p
			class="rise mt-5 max-w-[36ch] text-[20px] md:text-[24px] leading-snug tracking-[-0.015em] text-ink-2"
			style="--d: 100ms"
		>
			It may have moved or been removed. The links below will get you back on
			track.
		</p>
		<div class="rise mt-10 flex flex-col sm:flex-row gap-3" style="--d: 180ms">
			<a href="/" class="btn btn-primary">Back home</a>
			<a href="/blog" class="btn btn-ghost">Read the blog</a>
		</div>
	</section>
</Base>
