---
import { getCollection } from "astro:content";

import Base from "~/layouts/Base.astro";
import BlogFeed from "~/components/BlogFeed.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	const tags = new Set(posts.flatMap((p) => p.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: {
			posts: posts
				.filter((p) => p.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base
	title={`#${tag} · Blog · Arnab Paryali`}
	description={`Posts tagged #${tag}.`}
>
	<section class="pt-12 md:pt-20">
		<a href="/blog" class="link-more text-[15px] text-ink-3">
			<span aria-hidden="true">←</span> Back to blog
		</a>

		<h1
			class="mt-6 font-display text-[clamp(36px,7vw,64px)] leading-[1.05] text-ink"
		>
			#{tag}
		</h1>
		<p class="mt-3 text-[16px] text-ink-3">
			{posts.length}
			{posts.length === 1 ? "post" : "posts"}
		</p>

		<BlogFeed entries={posts} />
	</section>
</Base>
