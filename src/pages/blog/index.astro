---
import { getCollection } from "astro:content";

import Base from "~/layouts/Base.astro";
import BlogFeed from "~/components/BlogFeed.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Base
	title="Blog · Arnab Paryali"
	description="Field notes, logs, and half-formed ideas about React Native, TypeScript, and the web."
	image="/og/blog.png"
>
	<section class="pt-14 md:pt-20">
		<h1
			class="rise font-display text-[clamp(40px,8vw,80px)] leading-[1.04] text-ink"
		>
			Blog
		</h1>
		<p
			class="rise mt-5 max-w-[36ch] text-[20px] md:text-[24px] leading-snug tracking-[-0.015em] text-ink-2"
			style="--d: 100ms"
		>
			Notes on React Native, TypeScript and the web: patterns that stuck and the
			occasional post-mortem.
		</p>
		<p class="mt-4 text-[15px]">
			<a href="/rss.xml" class="link text-ink-3">RSS feed</a>
		</p>
		{
			posts.length > 0 ? (
				<BlogFeed entries={posts} groupByYear />
			) : (
				<p class="mt-12 text-[18px] text-ink-3">
					Nothing here yet. Check back soon, or{" "}
					<a href="/#contact" class="link text-ink">
						suggest a topic
					</a>
					.
				</p>
			)
		}
	</section>
</Base>
