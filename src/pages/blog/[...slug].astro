---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

import Base from "~/layouts/Base.astro";
import ViewCounter from "~/components/ViewCounter";
import ShareBar from "~/components/ShareBar";
import Giscus from "~/components/Giscus.astro";
import { fmtDate, getReadTime } from "~/utils/date";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const readTime = getReadTime(remarkPluginFrontmatter);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": post.data.pubDate.toISOString(),
	"dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
	"author": {
		"@type": "Person",
		"name": "Arnab Paryali",
		"url": "https://arnabxd.me",
	},
	"url": `https://arnabxd.me/blog/${post.id}`,
	"keywords": post.data.tags.join(", "),
	"image": `https://arnabxd.me/og/${post.id}.png`,
};

const postUrl = `https://arnabxd.me/blog/${post.id}`;
---

<Base
	title={`${post.data.title} · Arnab Paryali`}
	description={post.data.description}
	image={`/og/${post.id}.png`}
	article={{
		publishedTime: post.data.pubDate.toISOString(),
		tags: post.data.tags,
	}}
>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<article class="pt-12 md:pt-20">
		<nav aria-label="breadcrumb" class="fade" style="--d: 40ms">
			<a href="/blog" class="link-more text-[15px] text-ink-3">
				<span aria-hidden="true">←</span> Back to blog
			</a>
		</nav>

		<header
			class="mt-7 pb-8 md:pb-10 border-b border-rule rise"
			style="--d: 100ms"
		>
			<div
				class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[14px] text-ink-3 tabular"
			>
				<time datetime={post.data.pubDate.toISOString()}>
					{fmtDate(post.data.pubDate)}
				</time>
				{readTime && <span>{readTime}</span>}
				<ViewCounter client:only="react" slug={post.id} increment />
			</div>

			<h1
				class="mt-5 font-display text-[clamp(34px,6.5vw,60px)] leading-[1.06] text-ink max-w-[22ch] md:max-w-[26ch]"
			>
				{post.data.title}
			</h1>

			<p
				class="mt-5 text-[19px] md:text-[22px] leading-snug tracking-[-0.01em] text-ink-2 max-w-[56ch]"
			>
				{post.data.description}
			</p>

			{
				post.data.tags.length > 0 && (
					<ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink-3">
						{post.data.tags.map((t) => (
							<li>
								<a
									href={`/blog/tags/${encodeURIComponent(t)}`}
									class="hover:text-mark transition-colors"
								>
									#{t}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			post.data.cover && (
				<div class="mt-10 overflow-hidden rounded-xl border border-rule">
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? post.data.title}
						class="w-full"
					/>
				</div>
			)
		}

		<div class="prose prose-paper max-w-none mt-12 rise" style="--d: 200ms">
			<Content />
		</div>

		<footer
			class="mt-20 pt-6 border-t border-rule flex flex-wrap items-center justify-between gap-4 text-[14px] text-ink-3"
		>
			<a href="/blog" class="hover:text-mark transition-colors">
				← Back to blog
			</a>
			<ShareBar client:only="react" url={postUrl} title={post.data.title} />
			<span>Updated {fmtDate(post.data.updatedDate ?? post.data.pubDate)}</span>
		</footer>

		<Giscus />
	</article>
</Base>
