---
import { getCollection } from "astro:content";

import Base from "~/layouts/Base.astro";
import Hero from "~/components/Hero.astro";
import SectionLabel from "~/components/SectionLabel.astro";
import ExperienceList from "~/components/ExperienceList.astro";
import Education from "~/components/Education.astro";
import ProjectGrid from "~/components/ProjectGrid.astro";
import SkillMatrix from "~/components/SkillMatrix.astro";
import BlogFeed from "~/components/BlogFeed.astro";
import ContactPanel from "~/components/ContactPanel.astro";
import { data } from "~/data";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 3);
---

<Base image="/og/home.png">
	<Hero />

	<section class="mt-12 md:mt-24" aria-label="About">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
			<p
				class="md:col-span-8 text-[18px] md:text-[20px] leading-relaxed text-ink-2 max-w-[60ch]"
			>
				{data.site.tagline}
			</p>
			<dl class="md:col-span-4 space-y-4 text-[16px]">
				<div>
					<dt class="text-[14px] text-ink-3">Now</dt>
					<dd class="text-ink">Software Engineer at Metafic</dd>
				</div>
				<div>
					<dt class="text-[14px] text-ink-3">Stack</dt>
					<dd class="text-ink">React Native, Next.js, TypeScript</dd>
				</div>
				<div>
					<dt class="text-[14px] text-ink-3">Status</dt>
					<dd class="text-ink">Open to freelance and full-time</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="mt-16 md:mt-32">
		<SectionLabel name="Experience" id="experience" />
		<ExperienceList />
	</section>

	<section class="mt-16 md:mt-32">
		<SectionLabel name="Education" id="education" />
		<Education />
	</section>

	<section class="mt-16 md:mt-32">
		<SectionLabel name="Selected projects" id="projects" />
		<ProjectGrid limit={4} />
		<div class="mt-8">
			<a href="/works" class="link-more">
				All projects <span aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	<section class="mt-16 md:mt-32">
		<SectionLabel name="Skills" id="skills" />
		<SkillMatrix />
	</section>

	{
		posts.length > 0 && (
			<section class="mt-16 md:mt-32">
				<SectionLabel name="Writing" id="blog" />
				<BlogFeed entries={posts} compact />
				<div class="mt-2">
					<a href="/blog" class="link-more">
						All posts <span aria-hidden="true">→</span>
					</a>
				</div>
			</section>
		)
	}

	<section class="mt-16 md:mt-32">
		<SectionLabel name="Contact" id="contact-label" />
		<ContactPanel />
	</section>
</Base>
