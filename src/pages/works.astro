---
import Base from "~/layouts/Base.astro";
import ProjectGrid from "~/components/ProjectGrid.astro";
---

<Base
	title="Works · Arnab Paryali"
	description="Open-source builds, side projects, and tools - across React Native, Next.js, Go, Rust, and TypeScript."
	image="/og/works.png"
>
	<section class="pt-14 md:pt-20">
		<h1
			class="rise font-display text-[clamp(40px,8vw,80px)] leading-[1.04] text-ink"
		>
			Works
		</h1>
		<p
			class="rise mt-5 max-w-[36ch] text-[20px] md:text-[24px] leading-snug tracking-[-0.015em] text-ink-2"
			style="--d: 100ms"
		>
			Mobile apps, web platforms, open-source libraries and command-line tools,
			shipped to production or published to registries.
		</p>
		<ProjectGrid />
	</section>
</Base>
