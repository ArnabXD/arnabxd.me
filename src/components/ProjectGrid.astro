---
import { data } from "~/data";

type Props = {
	limit?: number;
};

const { limit } = Astro.props;
const projects = limit ? data.projects.slice(0, limit) : data.projects;

// Rows alternate wide+narrow / narrow+wide on a 3-col grid; a lone last
// item takes the full row so the grid never shows an empty cell.
const spans = projects.map((_, i) => {
	const row = Math.floor(i / 2);
	const first = i % 2 === 0;
	if (i === projects.length - 1 && first) return 3;
	const wideFirst = row % 2 === 0;
	return first === wideFirst ? 2 : 1;
});
const spanClass: Record<number, string> = {
	1: "md:col-span-1",
	2: "md:col-span-2",
	3: "md:col-span-3",
};
---

<div class="mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
	{
		projects.map((p, i) => {
			const isClient = p.confidential === true;
			const Tag = isClient ? "div" : "a";
			const tagProps = isClient
				? {}
				: { href: p.link, target: "_blank", rel: "noreferrer" };
			const wide = spans[i] !== 1;
			const meta = [p.client?.industry, p.client?.region, p.role]
				.filter(Boolean)
				.join(", ");

			return (
				<Tag
					{...tagProps}
					class:list={[
						"group flex flex-col rounded-xl border p-5 md:p-7 transition-colors",
						spanClass[spans[i]],
						wide
							? "bg-paper-2 border-rule-soft"
							: "bg-mark-tint border-transparent",
						!isClient && "hover:border-mark",
					]}
				>
					<div class="flex items-baseline justify-between gap-4">
						<h3 class="font-display text-[22px] md:text-[24px] leading-tight text-ink">
							{p.title}
						</h3>
						<span class="shrink-0 text-[14px] text-ink-3 tabular">
							{p.period}
						</span>
					</div>

					{meta && <p class="mt-1.5 text-[14px] text-ink-3">{meta}</p>}

					<p class="mt-4 text-[15.5px] text-ink-2 leading-relaxed line-clamp-4 max-w-[60ch]">
						{p.description}
					</p>

					{p.outcome && (
						<p class="mt-3 text-[14.5px] text-ink-2 max-w-[60ch]">
							<span class="font-medium text-ink">Outcome:</span> {p.outcome}
						</p>
					)}

					<div class="mt-auto pt-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
						<p class="font-mono text-[12px] text-ink-3 leading-relaxed">
							{p.tech.join(", ")}
						</p>
						{isClient ? (
							<span class="text-[14px] text-ink-3">Under NDA</span>
						) : (
							<span class="link-more text-[14px]">
								Source <span aria-hidden="true">↗</span>
							</span>
						)}
					</div>
				</Tag>
			);
		})
	}
</div>
