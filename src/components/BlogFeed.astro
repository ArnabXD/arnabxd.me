---
import type { CollectionEntry } from "astro:content";

type Props = {
	entries: CollectionEntry<"blog">[];
	compact?: boolean;
	groupByYear?: boolean;
};

const { entries, compact = false, groupByYear = false } = Astro.props;

const fmt = (date: Date) =>
	date.toLocaleDateString(
		"en-US",
		groupByYear
			? { month: "short", day: "numeric" }
			: { year: "numeric", month: "short", day: "numeric" },
	);

const groups = groupByYear
	? [
			...entries
				.reduce((m, e) => {
					const y = e.data.pubDate.getFullYear();
					m.set(y, [...(m.get(y) ?? []), e]);
					return m;
				}, new Map<number, CollectionEntry<"blog">[]>())
				.entries(),
		]
	: [[0, entries] as const];
---

<div class="mt-10 md:mt-12 space-y-12">
	{
		groups.map(([year, posts]) => (
			<div
				class:list={[
					groupByYear && "grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8",
				]}
			>
				{groupByYear && (
					<h3 class="md:col-span-3 font-display text-[28px] text-ink-3">
						{year}
					</h3>
				)}
				<ul
					class:list={[
						"divide-y divide-rule-soft",
						groupByYear && "md:col-span-9",
					]}
				>
					{posts.map((post) => (
						<li class="group relative py-6 first:pt-0 grid grid-cols-1 md:grid-cols-[120px_1fr] gap-1 md:gap-6">
							<a
								href={`/blog/${post.id}`}
								class="absolute inset-0"
								aria-label={post.data.title}
							/>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-[14px] text-ink-3 tabular md:pt-1.5"
							>
								{fmt(post.data.pubDate)}
							</time>
							<div>
								<h3 class="font-display text-[22px] md:text-[26px] leading-snug text-ink group-hover:text-mark transition-colors">
									{post.data.title}
								</h3>
								{!compact && (
									<p class="mt-2 text-[16px] text-ink-2 leading-relaxed max-w-[62ch] line-clamp-2">
										{post.data.description}
									</p>
								)}
								{post.data.tags.length > 0 && (
									<ul class="relative z-10 mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink-3">
										{post.data.tags.slice(0, 4).map((t) => (
											<li>
												<a
													href={`/blog/tags/${encodeURIComponent(t)}`}
													class="hover:text-mark transition-colors"
												>
													#{t}
												</a>
											</li>
										))}
									</ul>
								)}
							</div>
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
