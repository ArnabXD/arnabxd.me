---
import { data } from "~/data";

const { site, contact, nav } = data;
const year = new Date().getFullYear();
---

<footer class="mt-20 md:mt-36 border-t border-rule pt-10 pb-6">
	<div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
		<div class="md:col-span-6">
			<p class="font-display text-[28px] md:text-[34px] leading-tight text-ink">
				{site.name}
			</p>
			<a
				href={`mailto:${contact.email}`}
				class="link mt-3 inline-block text-[16px] text-ink-2"
			>
				{contact.email}
			</a>
		</div>

		<div class="md:col-span-3">
			<p class="text-[14px] text-ink-3 mb-3">Pages</p>
			<ul class="space-y-1.5 text-[15px] text-ink">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class="hover:text-mark transition-colors">
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/#contact" class="hover:text-mark transition-colors"
						>Contact</a
					>
				</li>
			</ul>
		</div>

		<div class="md:col-span-3">
			<p class="text-[14px] text-ink-3 mb-3">Elsewhere</p>
			<ul class="space-y-1.5 text-[15px] text-ink">
				<li>
					<a
						href={contact.socials.github}
						target="_blank"
						rel="noreferrer"
						class="hover:text-mark transition-colors">GitHub</a
					>
				</li>
				<li>
					<a
						href={contact.socials.linkedin}
						target="_blank"
						rel="noreferrer"
						class="hover:text-mark transition-colors">LinkedIn</a
					>
				</li>
				<li>
					<a
						href={contact.socials.twitter}
						target="_blank"
						rel="noreferrer"
						class="hover:text-mark transition-colors">Twitter</a
					>
				</li>
				<li>
					<a
						href={contact.socials.upwork}
						target="_blank"
						rel="noreferrer"
						class="hover:text-mark transition-colors">Upwork</a
					>
				</li>
			</ul>
		</div>
	</div>

	<p class="mt-12 text-[14px] text-ink-3">
		© {year}
		{site.name}. Built with Astro and Tailwind.
	</p>
</footer>
