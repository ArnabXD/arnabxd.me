---
import { data } from "~/data";

const items = data.education;
---

<div class="mt-10 md:mt-12 divide-y divide-rule-soft">
	{
		items.map((edu) => (
			<article class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-6 first:pt-0">
				<p class="md:col-span-3 text-[15px] text-ink-3 tabular">{edu.period}</p>
				<div class="md:col-span-9">
					<h3 class="font-display text-[22px] md:text-[24px] leading-tight text-ink">
						{edu.institution}
					</h3>
					<p class="mt-1 text-[16px] text-ink-2">
						{edu.degree}, CGPA {edu.cgpa}
					</p>
				</div>
			</article>
		))
	}
</div>
