---
import { data } from "~/data";

const groups = data.skills;
const formatTitle = (t: string) =>
	t
		.toLowerCase()
		.replace(/_/g, " ")
		.replace(/\b\w/g, (c) => c.toUpperCase());
---

<dl class="mt-10 md:mt-12 space-y-6 md:space-y-5">
	{
		groups.map((group) => (
			<div class="grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-8">
				<dt class="md:col-span-3 text-[15px] text-ink-3">
					{formatTitle(group.title)}
				</dt>
				<dd class="md:col-span-9 text-[17px] text-ink leading-relaxed">
					{group.skills.join(", ")}
				</dd>
			</div>
		))
	}
</dl>
