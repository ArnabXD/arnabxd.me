---
type Tone = "note" | "tip" | "warn" | "info";

type Props = {
	tone?: Tone;
	label?: string;
};

const { tone = "note", label } = Astro.props;

const palette: Record<string, { border: string; text: string }> = {
	note: { border: "border-l-accent", text: "text-accent" },
	tip: { border: "border-l-accent", text: "text-accent" },
	warn: { border: "border-l-alert", text: "text-alert" },
	info: { border: "border-l-ink", text: "text-ink" },
};

const c = palette[tone] ?? palette.note;
---

<aside
	class:list={[
		"not-prose my-8 rounded-xl border-l-2 bg-paper-2 px-5 py-4 text-[16px] text-ink-2",
		c.border,
	]}
>
	{
		label && (
			<div class:list={["mb-1 text-[14px] font-medium", c.text]}>{label}</div>
		)
	}
	<div class="leading-relaxed [&>p]:m-0 [&>p+p]:mt-2">
		<slot />
	</div>
</aside>
