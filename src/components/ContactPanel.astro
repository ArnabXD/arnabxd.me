---
import { data } from "~/data";
import ContactForm from "~/components/ContactForm";

const { contact } = data;
const socials = [
	["GitHub", contact.socials.github],
	["LinkedIn", contact.socials.linkedin],
	["Twitter", contact.socials.twitter],
	["Upwork", contact.socials.upwork],
] as const;
---

<div
	id="contact"
	class="mt-10 md:mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 scroll-mt-24"
>
	<aside class="lg:col-span-5">
		<p
			class="text-[20px] md:text-[22px] leading-snug tracking-[-0.01em] text-ink-2 max-w-[30ch]"
		>
			Freelance projects, full-time roles, or a chat about React Native
			performance.
		</p>

		<dl class="mt-8 space-y-5 text-[16px]">
			<div>
				<dt class="text-[14px] text-ink-3">Email</dt>
				<dd>
					<a href={`mailto:${contact.email}`} class="link text-ink">
						{contact.email}
					</a>
				</dd>
			</div>
			<div>
				<dt class="text-[14px] text-ink-3">Based in</dt>
				<dd>
					<a
						href={contact.location.url}
						target="_blank"
						rel="noreferrer"
						class="link text-ink"
					>
						{contact.location.text}, {contact.location.country}
					</a>
				</dd>
			</div>
			<div>
				<dt class="text-[14px] text-ink-3">Elsewhere</dt>
				<dd class="flex flex-wrap gap-x-5 gap-y-1">
					{
						socials.map(([label, href]) => (
							<a
								href={href}
								target="_blank"
								rel="noreferrer"
								class="link text-ink"
							>
								{label}
							</a>
						))
					}
				</dd>
			</div>
		</dl>

		<p class="mt-8 text-[14px] text-ink-3 max-w-[40ch] leading-relaxed">
			{contact.notice}
		</p>
	</aside>

	<div class="lg:col-span-7">
		<div class="rounded-xl border border-rule-soft bg-paper-2 p-5 md:p-9">
			<ContactForm client:visible />
		</div>
	</div>
</div>
