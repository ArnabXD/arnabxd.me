---
import { data } from "~/data";

const { site, nav } = data;
const path = Astro.url.pathname;
---

<div
	class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md border-b border-rule-soft"
>
	<header
		class="mx-auto max-w-300 px-6 md:px-12 lg:px-16 h-16 flex items-center justify-between gap-4"
	>
		<a
			href="/"
			class="font-display text-[18px] text-ink hover:text-mark transition-colors shrink-0"
			aria-label={site.name}
		>
			{site.name}
		</a>

		<nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
			{
				nav.map((item) => {
					const active = path.startsWith(item.href);
					return (
						<a
							href={item.href}
							aria-current={active ? "page" : undefined}
							class:list={[
								"relative px-3 py-2 text-[15px] transition-colors",
								active ? "text-ink font-medium" : "text-ink-3 hover:text-ink",
							]}
						>
							{item.label}
							{active && (
								<span
									aria-hidden="true"
									class="absolute left-3 right-3 bottom-0.5 h-0.5 rounded-full bg-mark"
								/>
							)}
						</a>
					);
				})
			}
		</nav>
	</header>
</div>
