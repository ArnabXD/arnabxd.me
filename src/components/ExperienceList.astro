---
import { data } from "~/data";

const items = data.experience;
---

<ol class="mt-10 md:mt-12 divide-y divide-rule-soft">
	{
		items.map((exp) => (
			<li class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 py-8 first:pt-0">
				<p class="md:col-span-3 text-[15px] text-ink-3 tabular md:pt-1.5">
					{exp.period}
				</p>
				<div class="md:col-span-9">
					<h3 class="font-display text-[24px] md:text-[28px] leading-tight text-ink">
						{exp.company}
					</h3>
					<p class="mt-1 text-[15px] text-ink-3">{exp.title}</p>
					<ul class="mt-4 space-y-2 text-[16px] text-ink-2 max-w-[62ch] list-disc pl-5 marker:text-mark">
						{exp.responsibilities.map((r) => (
							<li>{r}</li>
						))}
					</ul>
				</div>
			</li>
		))
	}
</ol>
